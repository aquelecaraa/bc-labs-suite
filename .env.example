# Copie este arquivo para .env.local (não versionado) e preencha com os valores
# do seu projeto Supabase: Project Settings → Data API.
# A anon/publishable key é pública por design (protegida pelo RLS no banco).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Necessária apenas quando o BC AI for conectado. Fica só no servidor,
# nunca é exposta com o prefixo VITE_ (não vai para o navegador).
ANTHROPIC_API_KEY=
